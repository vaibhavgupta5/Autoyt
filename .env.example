# Copy to .env and fill in:   cp .env.example .env
# .env is never committed and never copied into the Docker image.

# ---------------------------------------------------------------- REQUIRED
# AI clip selection. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Email notifications through your SMTP server
SMTP_HOST=
# 587 = STARTTLS (most providers), 465 = SSL
SMTP_PORT=587
SMTP_USERNAME=
# Gmail: use an App Password (Google Account > Security > App passwords), not your normal password
SMTP_PASSWORD=
# Address the mail is sent from (usually the same as SMTP_USERNAME)
SMTP_FROM=
# Where the summaries and alerts go
NOTIFY_EMAIL=

# Decides what counts as "today" for the once-a-day run
TZ=Asia/Kolkata

# ---------------------------------------------------------------- SAFE TO LEAVE AS IS
# scheduled = upload now, each video goes PUBLIC automatically at its own time slot, spread over the day
#             (recommended; YouTube shows it as "scheduled" until then, then it is public)
# public    = upload and publish PUBLIC immediately, all at once
# dry_run   = render only, nothing uploaded (to review clips in data/output/<day>/ first)
# private   = upload but keep PRIVATE, only for tests; never used unless you set it
AUTOYT_MODE=scheduled
# Final clips per day. After the first real upload it ramps 3 -> 5 -> this number (set RAMP_UP=false to skip)
CLIPS_PER_DAY=8
RAMP_UP=true
# auto = read YouTube's own captions to FIND clips (seconds), Whisper only on the chosen 55 s slices.
#        Falls back to Whisper on the whole video if a video has no captions (10-30 minutes).
# captions = captions only, skip videos without them | whisper = always transcribe the whole video
TRANSCRIPT_SOURCE=auto
# Local transcription model (used for clip slices, and for whole videos in the fallback).
# small.en is a good balance; tiny.en is faster, medium.en more accurate
WHISPER_MODEL=small.en
# Delete the local clip as soon as it is uploaded
DELETE_AFTER_UPLOAD=true
# Don't start a run on battery below this percent (ignored while charging)
MIN_BATTERY_PERCENT=40
# Don't start a run with less free disk than this
MIN_FREE_DISK_GB=15
# How often the container checks whether a run is due
POLL_MINUTES=15
# Your user and group id, so files in ./data stay yours (run `id -u` and `id -g`)
AUTOYT_UID=1000
AUTOYT_GID=1000
# Extra yt-dlp flags if ever needed, for example: YTDLP_ARGS=--proxy http://host:port
YTDLP_ARGS=

# ---------------------------------------------------------------- FILES, NOT VARIABLES
# secrets/client_secret.json   Google OAuth "Desktop app" client (see README.md)
# secrets/token.json           created once by: docker compose run --rm -p 8765:8765 autoyt auth
